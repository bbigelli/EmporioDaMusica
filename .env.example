# Gemini API key, from https://aistudio.google.com/apikey
#
# The google-genai SDK reads GOOGLE_API_KEY and GEMINI_API_KEY, preferring the
# former when both are set. This app mirrors that precedence, so either works.
GEMINI_API_KEY=your-key-here

# Model used by the agent. gemini-3.8-flash is tuned for agentic tool use;
# gemini-3.5-flash-lite is the cheaper fallback if free-tier limits bite.
EMPORIO_MODEL=gemini-3.8-flash

# The supplied dataset ends on 2026-03-22. Deadline-based policies (7-day
# right of withdrawal, 30-day defect exchange, 90-day legal warranty) only
# produce meaningful answers when "today" sits near the data.
#
# Set to an empty value to use the real system date instead.
EMPORIO_REFERENCE_DATE=2026-03-25
